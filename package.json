{
  "name": "evidence-osint-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "sources:verify": "tsx scripts/verify-sources.ts",
    "demo:package": "tsx scripts/package-demo.ts",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "demo": "tsx server/index.ts --store .local/demo-store.json",
    "build:showcase": "tsc --noEmit && vite build --config vite.showcase.config.ts && tsx scripts/package-showcase.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.12.0",
    "cheerio": "latest",
    "cytoscape": "^3.34.3",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/cytoscape": "^3.21.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
