":754,"end":805,"stance":"supports","wasDerivedFrom":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:DocumentSnapshot:source-a2f1baee-3fcf-48ac-8bb3-bb4e5865aa57"]},{"@id":"urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:OriginGroup:c-drone-budget%3Aorigin-ec916eeeaaf5","@type":"OriginGroup","label":"defensetoday.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-budget-e1","urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-budget-e2"]},{"@id":"urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Claim:c-drone-nonred","@type":"Claim","label":"같은 칼럼은 대만 국방부가 군용 드론 입찰에서 중국산 부품 사용을 금지하고 있으며, 행정원이 2027년까지 드론 공급망 전체를 비홍색으로 채운다는 목표를 내걸었다고 보도했다.","status":"single-origin","confidence":"medium","aboutActor":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Actor:e-mnd","urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Actor:e-ey"],"describes":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Entity:e-defensetoday"],"groundedIn":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-nonred-e1","urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-nonred-e2"],"hasOrigin":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:OriginGroup:c-drone-nonred%3Aorigin-ec916eeeaaf5"]},{"@id":"urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-nonred-e1","@type":"Quotation","label":"대만 국방부는 군용 드론 입찰에서 중국산 부품 사용을 금지하고 있다","start":934,"end":971,"stance":"supports","wasDerivedFrom":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:DocumentSnapshot:source-a2f1baee-3fcf-48ac-8bb3-bb4e5865aa57"]},{"@id":"urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:Quotation:c-drone-nonred-e2","@type":"Quotation","label":"행정원은 2027년까지 드론 공급망 전체를 비홍색으로 채운다는 목표를 내걸었다","start":1918,"end":1961,"stance":"supports","wasDerivedFrom":["urn:trace:run:9e101404-9b68-4941-9c47-6b903f0472d6:DocumentSnapshot:source-a2f1baee-3fcf-48ac-8bb3-bb4e5