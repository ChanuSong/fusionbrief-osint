id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-disclosure%3Aorigin-b975808deea2","@type":"OriginGroup","label":"koreatimes.co.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-disclosure-e2"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Claim:c-bh-notice","@type":"Claim","label":"청와대 고위 관계자는 우크라이나가 연설 전에 관련 언급이 있을 것이라고 알려왔으며, 한국은 송환을 공개해서는 안 된다는 입장을 설명했다고 말했다.","status":"single-origin","confidence":"medium","aboutActor":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-bh","urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-ukraine"],"groundedIn":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-bh-notice-e1","urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-bh-notice-e2"],"hasOrigin":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-bh-notice%3Aorigin-81b49785b505"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-bh-notice-e1","@type":"Quotation","label":"청와대 고위 관계자는 멕시코시티에서 기자들과 만나 젤렌스키 대통령의 유엔 연설 전에 우크라이나 측에서 관련 언급이 있을 것이라고 알려와 이를 사전에 인지하고 있었다고 말했다.","start":2553,"end":2650,"stance":"supports","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:DocumentSnapshot:source-32003c2a-cab4-46f4-b9be-4706c2520d7f"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-bh-notice-e2","@type":"Quotation","label":"이 과정에서 한국 측에서는 송환을 공개해서는 안 된다는 입장을 설명했다고 전했다.","start":2651,"end":2696,"stance":"supports","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:DocumentSnapshot:source-32003c2a-cab4-46f4-b9be-4706c2520d7f"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-bh-notice%3Aorigin-81b49785b505","@type":"OriginGroup","label":"yna.co.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:f