fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-lee","urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-ukraine"],"groundedIn":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-lee-measures-e1"],"hasOrigin":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-lee-measures%3Aorigin-b975808deea2"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-lee-measures-e1","@type":"Quotation","label":"President Lee Jae Myung warned Friday that Seoul will take \"additional measures\" if Ukraine refuses to apologize for disclosing the transfer","start":338,"end":478,"stance":"supports","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:DocumentSnapshot:source-3ca96d42-b5d2-4f9b-b7d4-d8e0ca7cdd1c"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-lee-measures%3Aorigin-b975808deea2","@type":"OriginGroup","label":"koreatimes.co.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-lee-measures-e1"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Claim:c-nis-no-support","@type":"Claim","label":"이종석 국정원장은 우크라이나가 송환 조건을 내건 적이 없고, 한국 정부도 우크라이나에 어떤 지원도 하지 않았다고 말했다.","status":"single-origin","confidence":"medium","aboutActor":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-lee-jongseok","urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-ukraine"],"groundedIn":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-no-support-e1"],"hasOrigin":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-nis-no-support%3Aorigin-ced99ba29607"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-no-support-e1","@type":"Quotation","label":"우크라이나 포로 송환과 관련해 우크라이나에서 우리에게 송환 조건을 내건 것도 없고, 우리 정부도 우크라이나 쪽에 어떤 지원도 없었다","start":1197,"end":1270,"stance":"supports","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:DocumentSnapshot:source-112c6295-2753-43de-a674-eb9ee190b2e3"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-nis-no-support%3Aorigin-ced99ba29607","@type":"OriginGroup","label":"yna.co.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-no-support-e1"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Claim:c-nis-motive","@type":"Claim","label":"국정원은 젤렌스키가 한국에서 무기 등 대우크라이나 지원 여론이 일어나기를 기대하고 송환 사실을 공개했을 것이라고 분석했다.","status":"single-origin","confidence":"medium","aboutActor":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-nis","urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Actor:e-zelensky"],"groundedIn":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-motive-e1"],"hasOrigin":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-nis-motive%3Aorigin-ced99ba29607"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-motive-e1","@type":"Quotation","label":"한국 측에서 우크라이나 정부에 무기 등 여러 지원을 해줄 여론이 일어나지 않을까","start":1365,"end":1409,"stance":"supports","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:DocumentSnapshot:source-112c6295-2753-43de-a674-eb9ee190b2e3"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:OriginGroup:c-nis-motive%3Aorigin-ced99ba29607","@type":"OriginGroup","label":"yna.co.kr","originVerified":true,"independence":"unconfirmed","wasDerivedFrom":["urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:Quotation:c-nis-motive-e1"]},{"@id":"urn:fusionbrief:run:823d7868-e5b0-4538-94cd-8cc049fe9ae9:ValidationReport:constraints","@type":"ValidationReport","label":"기준·사건·출처 관계 무결성 검증","conforms":true,"violations":[]}]}