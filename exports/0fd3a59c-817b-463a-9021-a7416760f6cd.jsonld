{"@context":{"fusionbrief":"urn:fusionbrief:ontology:","prov":"http://www.w3.org/ns/prov#","label":"http://www.w3.org/2000/01/rdf-schema#label","DocumentSnapshot":"fusionbrief:DocumentSnapshot","ImageSnapshot":"fusionbrief:ImageSnapshot","VisualObservation":"fusionbrief:VisualObservation","Forecast":"fusionbrief:Forecast","RiskAssessment":"fusionbrief:RiskAssessment","RecommendedAction":"fusionbrief:RecommendedAction","SimulatedFeed":"fusionbrief:SimulatedFeed","Provision":"fusionbrief:Provision","Criterion":"fusionbrief:Criterion","Claim":"fusionbrief:Claim","Quotation":"fusionbrief:Quotation","Observation":"fusionbrief:Observation","Assessment":"fusionbrief:Assessment","Judgment":"fusionbrief:Judgment","Actor":"fusionbrief:Actor","Entity":"fusionbrief:Entity","Event":"fusionbrief:Event","ResearchPlan":"fusionbrief:ResearchPlan","OriginGroup":"fusionbrief:OriginGroup","ValidationReport":"fusionbrief:ValidationReport","hasBasis":{"@id":"fusionbrief:hasBasis","@type":"@id"},"evaluates":{"@id":"fusionbrief:evaluates","@type":"@id"},"groundedIn":{"@id":"fusionbrief:groundedIn","@type":"@id"},"describes":{"@id":"fusionbrief:describes","@type":"@id"},"tests":{"@id":"fusionbrief:tests","@type":"@id"},"aboutActor":{"@id":"fusionbrief:aboutActor","@type":"@id"},"hasOrigin":{"@id":"fusionbrief:hasOrigin","@type":"@id"},"wasDerivedFrom":{"@id":"prov:wasDerivedFrom","@type":"@id"},"url":"fusionbrief:url","hash":"fusionbrief:hash","publishedAt":"fusionbrief:publishedAt","retrievedAt":"fusionbrief:retrievedAt","snapshotId":"fusionbrief:snapshotId","refreshState":"fusionbrief:refreshState","credit":"fusionbrief:credit","analysis":"fusionbrief:analysis","relevance":"fusionbrief:relevance","limitations":"fusionbrief:limitations","identityQuote":"fusionbrief:identityQuote","entityType":"fusionbrief:entityType","status":"fusionbrief:status","confidence":"fusionbrief:confidence","start":"fusionbrief:start","end":"fusionbrief:end","stance":"fusionbrief:stance","originVerified":"fusionbrief:originVerified","independence":"fusionbrief:independence","dimension":"fusionbrief:dimension","perspective":"fusionbrief:perspective","critical":"fusionbrief:critical","behavioral":"fusionbrief:behavioral","basisKind":"fusionbrief:basisKind","basisStatus":"fusionbrief:basisStatus","applicability":"fusionbrief:applicability","quote":"fusionbrief:quote","authority":"fusionbrief:authority","edition":"fusionbrief:edition","editionProof":"fusionbrief:editionProof","verification":"fusionbrief:verification","kind":"fusionbrief:kind","eventKey":"fusionbrief:eventKey","horizon":"fusionbrief:horizon","likelihood":"fusionbrief:likelihood","assumptions":"fusionbrief:assumptions","futureIndicators":"fusionbrief:futureIndicators","decision":"fusionbrief:decision","stoppingRule":"fusionbrief:stoppingRule","stages":"fusionbrief:stages","conforms":"fusionbrief:conforms","violations":"fusionbrief:violations"},"@id":"urn:fusionbrief:run:0fd3a59c-817b-463a-9021-a7416760f6cd:v1","@graph":[{"@id":"urn:fusionbrief:run:0fd3a59c-817b-463a-9021-a7416760f6cd:DocumentSnapshot:source-c9b7b1c4-c17e-4f87-b6b2-4632c6867179","@type":"DocumentSnapshot","label":"북한의 4대세습과 김주애 · 오경섭 · 통일연구원 CO 23-10","url":"https://www.kinu.or.kr/main/module/report/download.do?id=21997","hash":"0a9089be5c3462d6a17647350210da9bfb70a334edb3c74dcac9b18a94e5c4c4","publishedAt":"2023-03-13","retrievedAt":"2026-10-10T11:13:12.470Z","snapshotId":"norm-fe853c67f156dbc44d41d358e6d04293","refreshState":"fresh"},{"@id":"urn:fusionbrief:run:0fd3a59c-817b-463a-9021-a7416760f6cd:DocumentSnapshot:source-344eebd5-9d03-4be4-92b9-0d3de2aa9f7b","@type":"DocumentSnapshot","label":"국정원 \"김주애, 일부 시책에 의견 내…'후계 내정 단계' 판단\"(종합) | 연합뉴스","url":"https://www.yna.co.kr/view/AKR20260212101951001","hash":"b167d0c4fccb9eca824bf5a83695e552f92dd8e74838db7b54b7a4f3b4503693","publishedAt":"2026-02-12","retrievedAt":"2026-10-10T11:13:12.932Z"},{"@id":"urn:fusionbrief:run:0fd3a59c-817b-463a-9021-a7416760f6cd:DocumentSnapshot:source-bbc14ad7-1268-4031-