# Uses the logged-in official Cursor CLI and the account's subscription usage.
# No API key is needed when agent login has completed.
FUSIONBRIEF_CURSOR_BIN=agent
FUSIONBRIEF_CURSOR_MODEL=auto
# Search needs native WebSearch support; it can stay on auto when the analysis model changes.
FUSIONBRIEF_SEARCH_MODEL=auto

# Native Cursor WebSearch uses the existing CLI login. No separate search API key needed.
FUSIONBRIEF_SEARCH_PROVIDER=cursor

# Optional alternative: set FUSIONBRIEF_SEARCH_PROVIDER=brave to use this key.
BRAVE_SEARCH_API_KEY=

# Optional public image archive (default .local/media). Back up with report JSON and knowledge SQLite.
# FUSIONBRIEF_MEDIA_DIRECTORY=.local/media
