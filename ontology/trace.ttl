@prefix trace: <urn:trace:ontology:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

trace: a owl:Ontology ; rdfs:comment "Criterion-first public intelligence. Unknown does not entail false. Evidence dependence does not entail causality or legal applicability." .
trace:DocumentSnapshot a owl:Class ; rdfs:subClassOf prov:Entity .
trace:ImageSnapshot a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:comment "Immutable hash-addressed public image bytes; separate from article text." .
trace:VisualObservation a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:comment "Independently reviewed visible description. Does not entail identity, political authority or unstaged authenticity." .
trace:Forecast a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:comment "Conditional outlook with qualitative likelihood and distinct confidence. Future indicators are conditions, never observed events." .
trace:Provision a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Criterion a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Claim a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Quotation a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Observation a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Assessment a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Judgment a owl:Class ; rdfs:subClassOf prov:Entity .
trace:ResearchPlan a owl:Class ; rdfs:subClassOf prov:Entity .
trace:OriginGroup a owl:Class ; rdfs:subClassOf prov:Entity .
trace:ValidationReport a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:comment "Result of the executable application constraints. Not a claim that a SHACL or OWL reasoner was executed." .
trace:Actor a owl:Class ; rdfs:comment "An entity mentioned by a claim; not necessarily the creator of a document or a PROV responsible agent." .
trace:Entity a owl:Class ; rdfs:subClassOf prov:Entity .
trace:Event a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:comment "A named event, separate from an executed Observation or an Actor." .
trace:hasBasis a owl:ObjectProperty ; rdfs:domain trace:Criterion ; rdfs:range trace:Provision .
trace:evaluates a owl:ObjectProperty ; rdfs:domain trace:Assessment ; rdfs:range trace:Criterion .
trace:groundedIn a owl:ObjectProperty ; rdfs:comment "Explicit quotation or claim dependency. Does not imply truth or causality; inspect verification and stance." .
trace:tests a owl:ObjectProperty ; rdfs:domain trace:Observation ; rdfs:range trace:Criterion .
trace:aboutActor a owl:ObjectProperty ; rdfs:domain trace:Claim ; rdfs:range trace:Actor .
trace:hasOrigin a owl:ObjectProperty ; rdfs:domain trace:Claim ; rdfs:range trace:OriginGroup .
